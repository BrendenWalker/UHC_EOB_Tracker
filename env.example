# Database Configuration
# Use hostname/IP reachable from inside the container (LAN server, remote host, etc.)
DB_HOST=postgres.example.com
DB_PORT=5432
DB_NAME=eobtracker
DB_USER=eobtracker
DB_PASSWORD=your_password_here

# Backend Configuration
PORT=80

# Local dev only: if PostgreSQL runs on the Docker host machine, use:
# DB_HOST=host.docker.internal
# and add to docker-compose.yml under backend:
#   extra_hosts:
#     - "host.docker.internal:host-gateway"
