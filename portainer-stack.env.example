# Portainer stack environment variables (paste into Stack → Environment variables)

# Docker Hub (or registry) images — build and push before deploying the stack
DOCKER_HUB_REGISTRY_USERNAME=your-dockerhub-username
DOCKER_HUB_BACKEND_IMAGE_NAME=eobtracker-backend
DOCKER_HUB_FRONTEND_IMAGE_NAME=eobtracker-frontend
IMAGE_TAG=latest

# Host ports (defaults match local docker-compose)
BACKEND_PORT=8140
FRONTEND_PORT=8150

# PostgreSQL — use a hostname/IP reachable from the container network
DB_HOST=postgres.example.com
DB_PORT=5432
DB_NAME=eobtracker
DB_USER=eobtracker
DB_PASSWORD=your_password_here
